{
  "name": "munchling",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm wasm:prepare && nuxt dev",
    "build": "pnpm wasm:prepare && nuxt build",
    "build:server": "MUNCHLING_BUILD_MODE=server pnpm build",
    "generate": "pnpm wasm:prepare && MUNCHLING_BUILD_MODE=mobile nuxt generate",
    "wasm:prepare": "node scripts/prepare-wasm-assets.mjs",
    "food-db:build": "python3 scripts/build-food-search-db.py",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-backup-smoke.mjs",
    "test:responsive": "node scripts/browser-responsive-smoke.mjs",
    "test:server": "pnpm build:server && node scripts/test-server-db.mjs",
    "test:deployment": "docker build -t munchling:deployment-test . && MUNCHLING_TEST_IMAGE=munchling:deployment-test node scripts/test-server-db.mjs tests/server/deployment.test.ts",
    "typecheck": "nuxt typecheck",
    "typecheck:server": "MUNCHLING_BUILD_MODE=server nuxt typecheck",
    "postinstall": "nuxt prepare",
    "cap:sync": "pnpm generate && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "android:update": "bash scripts/update-android.sh"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/barcode-scanner": "^3.0.2",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/share": "^8.0.3",
    "@nuxt/icon": "^2.2.3",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "h3": "1.15.11",
    "jeep-sqlite": "2.8.0",
    "mariadb": "^3.5.4",
    "nuxt": "^4.4.8",
    "sql.js": "^1.14.1",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/node": "^22.20.5",
    "@types/sql.js": "^1.4.11",
    "consola": "^3.4.2",
    "sql.js-jeep": "npm:sql.js@1.11.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.4"
  }
}
