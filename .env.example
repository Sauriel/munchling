# Copy this file to .env and adjust local/sensitive values.
# .env is ignored by git.

# Android SDK / platform-tools
ANDROID_HOME=/home/$USER/android-sdk
ANDROID_SDK_ROOT=/home/$USER/android-sdk
ADB_BIN=/home/$USER/android-sdk/platform-tools/adb

# Java 21 is required by the Android build in this project.
JAVA_HOME=/home/$USER/.local/share/mise/installs/java/temurin-21

# Optional: pin one device if multiple phones/emulators are connected.
# Treat this as local/sensitive; keep it in .env, not committed.
# ADB_SERIAL=xxxxxxxx

# Debug APK defaults
GRADLE_TASK=assembleDebug
APK_PATH=android/app/build/outputs/apk/debug/app-debug.apk
APP_ID=dev.munchling.app
OPEN_AFTER_INSTALL=false

# Native/local preview remains the default. For the backend:
# pnpm build:server && node .output/server/index.mjs
# Set these privately at RUNTIME (e.g. Dokploy); never in runtimeConfig.public.
NUXT_MARIA_DB_HOST=127.0.0.1
NUXT_MARIA_DB_PORT=3306
NUXT_MARIA_DB_USER=munchling
NUXT_MARIA_DB_PASSWORD=
NUXT_MARIA_DB_DATABASE=munchling
NUXT_MARIA_DB_CONNECTION_LIMIT=5
# Required canonical origin for sync API Host/Origin checks (use actual URL):
NUXT_SYNC_PUBLIC_ORIGIN=http://localhost:3000
# Optional explicitly trusted origins; empty disables cross-origin access.
# Standard Capacitor origins, only if native sync is intended:
NUXT_SYNC_ALLOWED_ORIGINS=capacitor://localhost,http://localhost
# Backend is unauthenticated: expose only within the approved secure network.
