# Copy to .env for trusted LOCAL shell configuration; never commit .env.
# The Android update script sources it as shell code, not arbitrary dotenv data.

# Android: standard SDK locations / adb on PATH are discovered automatically.
# Override for your machine if needed:
# ANDROID_HOME=/path/to/Android/Sdk
# ANDROID_SDK_ROOT=/path/to/Android/Sdk
# ADB_BIN=/path/to/Android/Sdk/platform-tools/adb
# JAVA_HOME=/path/to/jdk-21
# ADB_SERIAL=your-device-serial
GRADLE_TASK=assembleDebug
APK_PATH=android/app/build/outputs/apk/debug/app-debug.apk
APP_ID=dev.munchling.app
OPEN_AFTER_INSTALL=false

# Optional exact DNS host accepting an owner-installed CA (not a URL/wildcard).
# Alternatively set userCaHost in ignored android/local-network.properties.
# No setting means system CA trust only. Empty env value disables local override.
# MUNCHLING_ANDROID_USER_CA_HOST=sync.example.internal

# Do NOT persist backup confirmation here. Make a fresh external backup, then:
# ANDROID_BACKUP_CONFIRMED=true pnpm android:update

# Backend variables must be set privately at RUNTIME (e.g. Dokploy).
# Production Nuxt does not automatically load .env. Never use public config.
NUXT_MARIA_DB_HOST=127.0.0.1
NUXT_MARIA_DB_PORT=3306
NUXT_MARIA_DB_USER=munchling
NUXT_MARIA_DB_PASSWORD=
NUXT_MARIA_DB_DATABASE=munchling
NUXT_MARIA_DB_CONNECTION_LIMIT=5
NUXT_SYNC_PUBLIC_ORIGIN=http://localhost:3000
# Exact native origins only when native synchronization is intended:
NUXT_SYNC_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost
# No authentication: keep website AND API behind a secure private network/VPN.
