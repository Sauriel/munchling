<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Normal servers keep Android's system CA trust. No cleartext bypass. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Optional exact-host owner-CA rule is generated locally by Gradle.
         No certificate or private key is bundled in the APK. -->
</network-security-config>
